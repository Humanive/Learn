{
  "name": "@humanive/learn-core",
  "version": "0.1.0",
  "description": "Shared core logic for Learn workspace system",
  "repository": {
    "type": "git",
    "url": "https://github.com/Humanive/Learn.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Humanive/Learn#readme",
  "bugs": {
    "url": "https://github.com/Humanive/Learn/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": ["dist", "README.md"],
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config.js",
    "./workspace": "./dist/workspace.js",
    "./sources": "./dist/sources.js",
    "./ingest": "./dist/ingest/router.js",
    "./types": "./dist/types.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "keywords": ["learning", "workspace", "knowledge-management"],
  "license": "MIT",
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "1.6.1"
  },
  "dependencies": {
    "js-yaml": "4.3.2"
  }
}
